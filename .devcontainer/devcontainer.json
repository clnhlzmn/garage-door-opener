{
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"C_Cpp.default.compileCommands": "garage-door-opener/build/compile_commands.json"
			},
			"extensions": [
				"ms-vscode.cpptools"
			]
		}
	},
	"mounts": ["source=${env:HOME}/.ssh,target=/root/.ssh,type=bind,readonly"]
}